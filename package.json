{
  "name": "tldw",
  "displayName": "tl;dw",
  "version": "9.0.0",
  "type": "module",
  "description": "Generate README files from package metadata and configurable fragments.",
  "keywords": [
    "bun",
    "cli",
    "documentation",
    "markdown",
    "readme",
    "readme-template"
  ],
  "author": "Jaid <jaid.jsx@gmail.com> (https://github.com/Jaid)",
  "homepage": "https://github.com/Jaid/tldw",
  "funding": "https://github.com/sponsors/jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:Jaid/tldw.git"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": "./src/cli.ts",
  "imports": {
    "#src/*": "./src/*",
    "#root/*": "./*"
  },
  "scripts": {
    "build": "build_lib --mode production",
    "check": "bun run lint && bun run typecheck && bun run test",
    "dev": "bun --watch src/cli.ts",
    "lint": "bun x eslint src test package.json eslint.config.ts",
    "start": "bun src/cli.ts",
    "test": "bun test --max-concurrency 1 ./test",
    "typecheck": "bun x tsc --noEmit"
  },
  "dependencies": {
    "camelcase": "9.0.0",
    "chalk": "6.0.0",
    "clerc": "1.3.1",
    "fencen": "0.1.0",
    "filesize": "11.0.24",
    "flatten-string": "0.2.0",
    "forward-slash-path": "0.3.0",
    "fs-extra": "11.4.0",
    "globby": "16.2.4",
    "jiti": "2.7.0",
    "markdown-map": "0.3.0",
    "trim-around": "0.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "eslint-config-jaid": "33.0.0",
    "github-markdown-css": "5.9.0",
    "rehype-stringify": "10.0.1",
    "remark": "15.0.1",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-html": "16.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tsconfig-jaid-bun": "16.0.0",
    "typescript": "npm:typescript-classic@6.0.4",
    "unified": "11.0.5",
    "@types/bun": "1.4.2"
  },
  "files": [
    "src",
    "license.txt",
    "readme.md"
  ]
}
